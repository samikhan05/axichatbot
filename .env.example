# Copy this file to .env and fill in your actual values.
# Never commit the real .env file — it contains secret API keys.

# ---- Groq API (used for the LLM and Speech-to-Text) ----
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=axichatbot
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

SIMLI_API_KEY=your_simli_api_key_here
SIMLI_FACE_ID=your_simli_face_id_here

# ---- Azure Cognitive Services (Text-to-Speech) ----
# Free tier (F0): 500,000 chars/month — no credit card needed
# Get your key at: https://portal.azure.com → Create resource → "Speech"
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
# Voices (Azure neural voices). The voice is picked from the reply language.
AZURE_VOICE_UR=ur-PK-UzmaNeural
# English words inside Urdu replies (spoken by a second voice, joined without breaks)
AZURE_VOICE_UR_ENGLISH=en-IN-NeerjaNeural
AZURE_VOICE_EN=en-US-AvaMultilingualNeural

# ---- Retrieval tuning (optional) ----
QDRANT_URL=http://localhost:6333
RAG_TOP_K=3
RAG_CANDIDATES=12
# Cross-encoder reranker (BAAI/bge-reranker-v2-m3, ~2.2 GB download, runs locally).
# Better ranking, adds ~0.3-1s per search on CPU.
RERANK_ENABLED=false

# ---- LLM (Groq) ----
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
